
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>DEMEN YOGA</title>

<style>
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #071b36;
  color: white;
}

header {
  background: #087eaa;
  text-align: center;
  padding: 30px 10px;
}

h1 {
  color: #ffdf45;
  font-size: 38px;
  margin: 0;
}

main {
  padding: 20px;
  max-width: 600px;
  margin: auto;
}

h2 {
  text-align: center;
  color: #ffdf45;
}

.daftar {
  background: white;
  color: #071b36;
  padding: 20px;
  border-radius: 10px;
}

.daftar li {
  padding: 10px 5px;
  border-bottom: 1px solid #ddd;
  font-size: 18px;
}

footer {
  text-align: center;
  padding: 20px;
  color: #ccc;
  font-size: 13px;
}
</style>
</head>

<body>

<header>
  <h1>DEMEN YOGA</h1>
  <p>DAFTAR NAMA ANGGOTA</p>
</header>

<main>
  <h2>Daftar Anggota</h2>

  <div class="daftar">
    <ol>
      <!-- TAMBAHKAN NAMA ANGGOTA DI BAWAH INI -->
      <li>Nama Anggota 1</li>
      <li>Nama Anggota 2</li>
      <li>Nama Anggota 3</li>
      <!-- TAMBAHKAN NAMA ANGGOTA DI ATAS INI -->
    </ol>
  </div>
</main>

<footer>
  DEMEN YOGA
</footer>

</body>
</html>
